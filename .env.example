# 로컬 테스트용. 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env
#
# .env 는 절대 git 에 커밋하지 마세요 (.gitignore 에 이미 등록돼 있습니다).
# GitHub Actions 로 돌릴 때는 이 파일이 아니라 저장소 Settings > Secrets 에 넣습니다.
#
# --dry-run 으로 요약 품질만 볼 거라면 ANTHROPIC_API_KEY 하나만 채워도 됩니다.

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
